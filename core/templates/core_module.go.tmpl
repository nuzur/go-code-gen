package {{.Package}}

import (
	"context"
	"sync"
	"time"
	"golang.org/x/sync/singleflight"
	"go.uber.org/zap"
	gocache "github.com/patrickmn/go-cache"
	"{{.Project.Module}}/{{.Project.CoreConfig.CoreDir}}/{{.Project.CoreConfig.RepoConfig.Dir}}"
	coretypes "{{.Project.Module}}/{{.Project.CoreConfig.CoreDir}}/types"
	"{{.Project.Module}}/{{.Project.CoreConfig.CoreDir}}/module/{{.EntityIdentifier}}/types"
	{{if eq .Project.MonitoringConfig.Enabled true}}
	"{{.Project.Module}}/monitoring"
	{{end}}
	{{if eq .Project.CoreConfig.EventsConfig.Enabled true}}
	"{{.Project.Module}}/{{.Project.CoreConfig.CoreDir}}/{{.Project.CoreConfig.EventsConfig.Dir}}"
	{{end}}
)

type Module interface {
    {{range $select := .SelectStatements}}
    Fetch{{$select.Name}}(ctx context.Context, req types.Fetch{{$select.Name}}Request, opts ...Option) (types.Fetch{{$select.Name}}Response, error){{end}}	

	List(ctx context.Context, req types.ListRequest, opts ...Option) (types.ListResponse, error)
	
	Upsert(ctx context.Context, req types.UpsertRequest, opts ...Option) (types.UpsertResponse, error)
	Insert(ctx context.Context, req types.UpsertRequest, opts ...Option) (types.UpsertResponse, error)
	Update(ctx context.Context, req types.UpsertRequest, opts ...Option) (types.UpsertResponse, error)
	Delete(ctx context.Context, req types.DeleteRequest, opts ...Option) error

}

type module struct {
	mu         sync.Mutex
	sg         singleflight.Group
	cache      *gocache.Cache
	repository *repository.Implementation
	logger     *zap.Logger
	{{if eq .Project.MonitoringConfig.Enabled true}}
	monitoring *monitoring.Implementation
	{{end}}
	{{if eq .Project.CoreConfig.EventsConfig.Enabled true}}
	events     *events.Implementation
	{{end}}
}

func New(params coretypes.ModuleParams) Module {
	return &module{
		repository: params.Repository,
		logger:     params.Logger,
		cache:      gocache.New(30*time.Second, 5*time.Minute),
		{{if eq .Project.MonitoringConfig.Enabled true}}
		monitoring: params.Monitoring,
		{{end}}
		{{if eq .Project.CoreConfig.EventsConfig.Enabled true}}
		events: params.Events,
		{{end}}
	}
}
