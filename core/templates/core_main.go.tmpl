package core

{{$coreDir := .CoreConfig.CoreDir}}
import (
	"database/sql"
	"errors"
	"fmt"
	"context"
	"time"

	{{if eq .CoreConfig.RepoConfig.DatabaseType "postgresql"}}
	_ "github.com/lib/pq"
	{{else if eq .CoreConfig.RepoConfig.DatabaseType "mysql"}}
	_ "github.com/go-sql-driver/mysql"
	{{end}}
	
	"go.uber.org/config"
	"go.uber.org/fx"	
	"go.uber.org/zap"
	{{.Identifier}}config "{{.Module}}/config"
	coretypes "{{.Module}}/{{$coreDir}}/types"
    {{$projectIdentifier := .Module}}
    {{range $entity := .StandaloneEntities}}
    "{{$projectIdentifier}}/{{$coreDir}}/module/{{$entity.Identifier}}"	
    {{end}}	
	"{{.Module}}/{{$coreDir}}/{{.CoreConfig.RepoConfig.Dir}}"
	{{if eq .MonitoringConfig.Enabled true}}
	"{{.Module}}/monitoring"
	{{end}}
	{{if eq .CoreConfig.EventsConfig.Enabled true}}
	"{{.Module}}/{{$coreDir}}/{{.CoreConfig.EventsConfig.Dir}}"
	{{end}}
	
)

type Implementation struct {
	db 			   *sql.DB
	repository     *repository.Implementation
	logger         *zap.Logger
    {{range $entity := .StandaloneEntities}}
    {{$entity.Identifier}}       {{$entity.Identifier}}.Module
    {{end}}	
	{{if eq .MonitoringConfig.Enabled true}}
	monitoring *monitoring.Implementation
	{{end}}
	{{if eq .CoreConfig.EventsConfig.Enabled true}}
	events *events.Implementation
	{{end}}
}

type Params struct {
	fx.In
	Provider config.Provider
	Lifecycle fx.Lifecycle	
	Logger *zap.Logger `optional:"true"`
	{{if eq .MonitoringConfig.Enabled true}}
	Monitoring *monitoring.Implementation
	{{end}}
	{{if eq .CoreConfig.EventsConfig.Enabled true}}
	Events *events.Implementation
	{{end}}
}

func New(params Params) (*Implementation, error) {

	var dbs {{.Identifier}}config.DBs
	if err := params.Provider.Get("db").Populate(&dbs); err != nil {
		return nil, err
	}

	if len(dbs) == 0 {
		return nil, errors.New("db configuration not found")
	}

	dbconfig := dbs[0]
	db, err := sql.Open(dbconfig.Driver, dbconfig.Path())
	if err != nil {
		return nil, fmt.Errorf("error connecting to DB: %v", err)
	}	
	db.SetConnMaxLifetime(0)
	db.SetMaxIdleConns(10)
	db.SetMaxOpenConns(0)
	repository := repository.New(db)

	logger := params.Logger
	if logger == nil {
		logger = zap.NewNop()
	}

	if params.Lifecycle != nil {
		params.Lifecycle.Append(fx.Hook{
			OnStart: func(ctx context.Context) error {
				// Warm the connection pool and fail fast with a clear error if the
				// database is unreachable or credentials/permissions are wrong,
				// instead of surfacing it later as a request-time timeout.
				pingCtx, cancel := context.WithTimeout(ctx, 10*time.Second)
				defer cancel()
				if err := db.PingContext(pingCtx); err != nil {
					logger.Error("failed to connect to database on startup", zap.Error(err))
					return fmt.Errorf("error connecting to DB: %w", err)
				}
				logger.Info("connected to database")
				return nil
			},
			OnStop: func(ctx context.Context) error {
				db.Close()
				return nil
			},
		})
	}

	impl := &Implementation{
		db: db,
		repository: repository,
		logger: logger,
		{{if eq .MonitoringConfig.Enabled true}}
		monitoring: params.Monitoring,
		{{end}}
		{{if eq .CoreConfig.EventsConfig.Enabled true}}
		events: params.Events,
		{{end}}
	}

	// Every module is built ONCE, here, and the accessors below just hand it
	// back. The accessors used to build their module lazily on a VALUE receiver,
	// so the assignment landed on a copy that was thrown away when the method
	// returned: every one of the (hundreds of) accessor calls in the transports
	// constructed a fresh module — with a fresh, empty 30s cache and its own
	// janitor goroutine — which is why the per-entity cache never served a hit
	// and WithSkipCache() meant nothing.
	//
	// Constructing eagerly rather than lazily on a POINTER receiver is
	// deliberate: the lazy branch would otherwise be a data race, since the
	// accessors are called concurrently from request handlers.
	{{range $entity := .StandaloneEntities}}
	impl.{{$entity.Identifier}} = {{$entity.Identifier}}.New(coretypes.ModuleParams{
		Repository: repository,
		Logger:     logger,
		{{if eq $.MonitoringConfig.Enabled true}}
		Monitoring: params.Monitoring,
		{{end}}
		{{if eq $.CoreConfig.EventsConfig.Enabled true}}
		Events: params.Events,
		{{end}}
	})
	{{end}}

	return impl, nil
}


func (i *Implementation) Destroy() {
	i.db.Close()
}

func (i *Implementation) DB() *sql.DB{
	return i.db
}

{{range $entity := .StandaloneEntities}}
// {{$entity.Identifier | ToCamelCase}} returns the process-wide {{$entity.Identifier}} module built in New.
// The receiver is a POINTER, like Destroy/DB above: a value receiver here would
// copy the struct on every call, which is how the previous lazy initialization
// came to be discarded.
func (i *Implementation) {{$entity.Identifier | ToCamelCase}}() {{$entity.Identifier}}.Module {
	return i.{{$entity.Identifier}}
}
{{end}}