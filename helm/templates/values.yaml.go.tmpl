# Default values for <<.Identifier>>.
# This is a YAML-formatted file.
# Declare variables to be passed into your templates.

replicaCount: 1

image:
  repository: <<.HelmImageRepository>>
  # Always, paired with a moving tag, is what makes a re-deploy actually pull.
  # Irrelevant when digest is set, since a digest is immutable.
  pullPolicy: Always
  # Overrides the image tag whose default is the chart appVersion.
  tag: ""
  # Pin an immutable image by digest ("sha256:..."). Takes precedence over tag.
  # Prefer this for anything you may need to roll back.
  digest: ""

# ghcr.io packages are private by default. Create the secret out of band:
#   kubectl -n <namespace> create secret docker-registry ghcr-login-secret \
#     --docker-server=ghcr.io --docker-username=<user> --docker-password=<token>
imagePullSecrets:
  - name: ghcr-login-secret
nameOverride: ""
fullnameOverride: ""

# Environment for the container.
#
# CONFIG is a COMMA-SEPARATED SEARCH PATH, loaded left to right with later
# entries overriding earlier ones. That is what makes the two-layer scheme work:
#
#   /root/config                      baked into the image; the generated,
#                                     non-secret base.yaml
#   <<.HelmConfig.CredentialsMountPath>>/<<.HelmConfigDirName>>   mounted from the node; YOUR prod.yaml
#                                     with the real db credentials
#
# Nothing is hidden by the mount because the two are separate directories — see
# volumes/volumeMounts below. ENV=prod is already baked into the image.
env:
  - name: CONFIG
    value: "/root/config,<<.HelmConfig.CredentialsMountPath>>/<<.HelmConfigDirName>>"
  # Individual secrets that do not belong in the credentials file can come from
  # k8s Secrets instead. optional: true lets the app start when one is absent.
  # - name: AWS_SECRET
  #   valueFrom:
  #     secretKeyRef:
  #       name: <<.Identifier>>-aws-secret
  #       key: secret_access_key
  #       optional: true

serviceAccount:
  # Specifies whether a service account should be created
  create: true
  # The app never talks to the Kubernetes API, so it has no use for a mounted
  # API token.
  automount: false
  # Annotations to add to the service account
  annotations: {}
  # The name of the service account to use.
  # If not set and create is true, a name is generated using the fullname template
  name: ""

podAnnotations: {}
podLabels: {}

podSecurityContext: {}
  # fsGroup: 2000

securityContext: {}
  # The image currently runs as root out of /root, so readOnlyRootFilesystem and
  # runAsNonRoot need Dockerfile changes before they can be turned on.
  # capabilities:
  #   drop:
  #   - ALL
  # allowPrivilegeEscalation: false

service:
  type: ClusterIP
<<- if .ServesGRPC>>
  grpcPort: <<.APIConfig.GRPCPort>>
<<- end>>
<<- if .ServesHTTP>>
  httpPort: <<.APIConfig.HTTPPort>>
<<- end>>

# The HTTP Ingress, fronting service.httpPort.
#
# enabled follows the configured hostname: on when a domain was set for a layer
# this app actually serves, off otherwise. There is no mode flag, and no
# placeholder host to forget to replace — templates/ingress.yaml is emitted
# EMPTY unless both hold, so switching this on by hand on a chart with no HTTP
# domain produces nothing at all.
<<- if not .ServesHTTP>>
#
# This app serves no HTTP, so nothing here can ever apply: the block is kept
# only because NOTES.txt reads ingress.enabled.
<<- end>>
ingress:
  enabled: <<if .ServesHTTPIngress>>true<<else>>false<<end>>
  className: "nginx"
  annotations: {}
    # cert-manager.io/cluster-issuer: lets-encrypt   # check yours:
    #   kubectl get clusterissuer
    # Hand-editing here does not survive: this file is regenerated every
    # run. Put it in values-custom.yaml, which is yours.
  hosts:
    - host: "<<.HelmConfig.Domain>>"
      paths:
        - path: /
          pathType: Prefix
  tls: []
  #  - secretName: <<.Identifier>>-tls
  #    hosts:
  #      - "<<.HelmConfig.Domain>>"
<<- if .ServesGRPC>>

# The gRPC Ingress, fronting service.grpcPort — a SECOND Ingress object, on its
# own hostname, generated as templates/ingress-grpc.yaml.
#
# It cannot be another rule on the block above:
# nginx.ingress.kubernetes.io/backend-protocol is an annotation on the Ingress
# OBJECT, so a single Ingress speaks exactly one protocol to its backend. An app
# serving both protocols needs two objects, which is why there are two hostnames.
#
# The gRPC annotations (backend-protocol, grpc-backend, protocol h2c, and the
# body-size/timeout lifts streaming needs) are baked into that template rather
# than listed here, so they cannot be dropped by overriding annotations. What
# you put here is merged on top of them.
grpcIngress:
  enabled: <<if .ServesGRPCIngress>>true<<else>>false<<end>>
  className: "nginx"
  annotations: {}
    # cert-manager.io/cluster-issuer: lets-encrypt   # check yours:
    #   kubectl get clusterissuer
    # Hand-editing here does not survive: this file is regenerated every
    # run. Put it in values-custom.yaml, which is yours.
  hosts:
    - host: "<<.HelmConfig.GRPCDomain>>"
      paths:
        - path: /
          pathType: Prefix
  tls: []
  #  - secretName: <<.Identifier>>-grpc-tls
  #    hosts:
  #      - "<<.HelmConfig.GRPCDomain>>"
<<- end>>

# Requests are not optional in practice: horizontal autoscaling targets CPU
# utilization as a percentage OF THE REQUEST, so with none set the HPA reports
# <unknown>/80% and never scales.
resources:
  limits:
    cpu: 1000m
    memory: 512Mi
  requests:
    cpu: 200m
    memory: 128Mi

autoscaling:
  enabled: false
  minReplicas: 1
  maxReplicas: 100
  targetCPUUtilizationPercentage: 80
  # targetMemoryUtilizationPercentage: 80

<<- if and .ServesHTTP .HelmHTTPProbePath>>

# Probes hit <<.HelmHTTPProbePath>>, which this app actually serves. Unlike a TCP
# check, an HTTP probe fails when the process is up but not really serving.
livenessProbe:
  httpGet:
    path: <<.HelmHTTPProbePath>>
    port: http
  initialDelaySeconds: 10
  periodSeconds: 15
  timeoutSeconds: 5
  failureThreshold: 3

readinessProbe:
  httpGet:
    path: <<.HelmHTTPProbePath>>
    port: http
  initialDelaySeconds: 5
  periodSeconds: 10
  timeoutSeconds: 5
  failureThreshold: 3
<<- else if .ServesHTTP>>

# This app serves HTTP but exposes no endpoint safe to poll unauthenticated, so
# fall back to checking the port accepts connections.
livenessProbe:
  tcpSocket:
    port: http
  initialDelaySeconds: 10
  periodSeconds: 15

readinessProbe:
  tcpSocket:
    port: http
  initialDelaySeconds: 5
  periodSeconds: 10
<<- else if .ServesGRPC>>

# gRPC-only: kubelet speaks the gRPC health protocol natively, so this needs no
# extra endpoint in the app.
livenessProbe:
  grpc:
    port: <<.APIConfig.GRPCPort>>
  initialDelaySeconds: 10
  periodSeconds: 15

readinessProbe:
  grpc:
    port: <<.APIConfig.GRPCPort>>
  initialDelaySeconds: 5
  periodSeconds: 10
<<- end>>

# Seconds kubelet waits after SIGTERM before SIGKILL.
terminationGracePeriodSeconds: 30

# Old ReplicaSets kept for rollback.
revisionHistoryLimit: 5

# Credentials volume: a directory on the NODE holding config this chart does not
# manage. You create <<.HelmConfig.CredentialsHostPath>>/<<.HelmConfigDirName>>/prod.yaml
# yourself, with the real db block and any secrets. It is deliberately not a
# Secret or ConfigMap: keeping it off the release means credentials never reach
# Helm, whose stored release values are readable with `helm get values`.
volumes:
  - name: config
    hostPath:
      path: "<<.HelmConfig.CredentialsHostPath>>"

volumeMounts:
  - name: config
    mountPath: "<<.HelmConfig.CredentialsMountPath>>"
    readOnly: true

nodeSelector: {}

tolerations: []

affinity: {}
<<- if .HasAuthSubchart>>

# The auth server, deployed from charts/<<.AuthChartIdentifier>>.
#
# It is the SAME image as this chart, run a second time exposing only its HTTP
# side — the JWT endpoints — on its own hostname. Values here override that
# subchart's own defaults.
#
# `enabled` is read by the condition on the dependency in Chart.yaml, so it is
# what installs the subchart at all; the ingress block below follows the
# configured auth domain, exactly as this chart's own does.
<<.AuthChartIdentifier>>:
  enabled: true
  # image: inherited defaults live in the subchart's values.yaml. The deploy
  # sets repository/tag/digest on both charts so they can never diverge.
  ingress:
    enabled: <<if .ServesAuthIngress>>true<<else>>false<<end>>
    hosts:
      - host: "<<.HelmConfig.AuthDomain>>"
        paths:
          - path: /
            pathType: Prefix
<<- end>>
