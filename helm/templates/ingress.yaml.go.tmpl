<<if .ServesHTTP>>
{{ $hosts := list -}}
{{- range .Values.ingress.hosts }}{{- if .host }}{{- $hosts = append $hosts . }}{{- end }}{{- end }}
{{ if and .Values.ingress.enabled $hosts -}}
{{- /* $hosts, not .Values.ingress.hosts: an entry with an empty host renders
       `- host: ""`, which ingress-nginx reads as a CATCH-ALL rule — it
       would answer for every hostname reaching the controller, including
       other releases' . Dropping the empties, and skipping the object
       entirely when none are left, is what makes `ingress.enabled=true`
       with no host supplied a no-op instead of a cluster-wide one.

       This is also why the template is generated whenever the app serves
       HTTP, rather than only when a host is configured at GENERATION time:
       hosts arrive at install time too (nuzur deploy passes them), and a
       template that does not exist ignores them silently. */}}
{{- $fullName := include "<<.Identifier>>.fullname" . -}}
{{- /* The HTTP side of the app. The gRPC side, when there is one, is a
       SEPARATE Ingress object (ingress-grpc.yaml) on its own hostname:
       backend-protocol is an annotation on the object, so one Ingress can
       only ever speak one protocol to its backend. */}}
{{- $svcPort := .Values.service.httpPort -}}
{{- if and .Values.ingress.className (not (semverCompare ">=1.18-0" .Capabilities.KubeVersion.GitVersion)) }}
  {{- if not (hasKey .Values.ingress.annotations "kubernetes.io/ingress.class") }}
  {{- $_ := set .Values.ingress.annotations "kubernetes.io/ingress.class" .Values.ingress.className}}
  {{- end }}
{{- end }}
{{- if semverCompare ">=1.19-0" .Capabilities.KubeVersion.GitVersion -}}
apiVersion: networking.k8s.io/v1
{{- else if semverCompare ">=1.14-0" .Capabilities.KubeVersion.GitVersion -}}
apiVersion: networking.k8s.io/v1beta1
{{- else -}}
apiVersion: extensions/v1beta1
{{- end }}
kind: Ingress
metadata:
  name: {{ $fullName }}
  labels:
    {{- include "<<.Identifier>>.labels" . | nindent 4 }}
  {{- with .Values.ingress.annotations }}
  annotations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
spec:
  {{- if and .Values.ingress.className (semverCompare ">=1.18-0" .Capabilities.KubeVersion.GitVersion) }}
  ingressClassName: {{ .Values.ingress.className }}
  {{- end }}
  {{- if .Values.ingress.tls }}
  tls:
    {{- range .Values.ingress.tls }}
    - hosts:
        {{- range .hosts }}
        - {{ . | quote }}
        {{- end }}
      secretName: {{ .secretName }}
    {{- end }}
  {{- end }}
  rules:
    {{- range $hosts }}
    - host: {{ .host | quote }}
      http:
        paths:
          {{- range .paths }}
          - path: {{ .path }}
            {{- if and .pathType (semverCompare ">=1.18-0" $.Capabilities.KubeVersion.GitVersion) }}
            pathType: {{ .pathType }}
            {{- end }}
            backend:
              {{- if semverCompare ">=1.19-0" $.Capabilities.KubeVersion.GitVersion }}
              service:
                name: {{ $fullName }}
                port:
                  number: {{ $svcPort }}
              {{- else }}
              serviceName: {{ $fullName }}
              servicePort: {{ $svcPort }}
              {{- end }}
          {{- end }}
    {{- end }}
{{- end }}
<<- end>>
