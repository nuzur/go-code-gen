package jwtserver

import (
	"encoding/json"
	"errors"
	"net/http"
	"time"

	"github.com/golang-jwt/jwt/v5"
)

func (i *Implementation) Refresh(w http.ResponseWriter, r *http.Request) {
	var tknReq TokenRefresh
	// Get the JSON body and decode into credentials
	err := json.NewDecoder(r.Body).Decode(&tknReq)
	if err != nil {
		// If the structure of the body is wrong, return an HTTP error
		writeError(w, http.StatusBadRequest, `invalid request body, expected JSON {"token":"..."}`)
		return
	}
	tknStr := tknReq.Token
	claims := &Claims{}
	tkn, err := jwt.ParseWithClaims(tknStr, claims, func(token *jwt.Token) (interface{}, error) {
		return i.key, nil
	}, jwt.WithValidMethods([]string{jwt.SigningMethodHS256.Alg()}))
	// err is checked BEFORE tkn is touched. ParseWithClaims returns a NIL token
	// when the string does not split into three segments — true of jwt-go v3 and
	// of golang-jwt v5 alike — so the previous order (`if !tkn.Valid` first)
	// panicked on any malformed token, including the empty string. net/http
	// recovered per-connection, so the caller just saw the connection drop.
	if err != nil {
		switch {
		case errors.Is(err, jwt.ErrTokenExpired):
			writeError(w, http.StatusUnauthorized, "token has expired, sign in again")
		case errors.Is(err, jwt.ErrTokenSignatureInvalid):
			writeError(w, http.StatusUnauthorized, "token signature is invalid")
		default:
			writeError(w, http.StatusUnauthorized, "token is malformed or invalid")
		}
		return
	}
	if tkn == nil || !tkn.Valid {
		writeError(w, http.StatusUnauthorized, "token is malformed or invalid")
		return
	}

	// We ensure that a new token is not issued until enough time has elapsed
	// In this case, a new token will only be issued if the old token is within
	// 30 seconds of expiry. Otherwise, return a bad request status
	if claims.ExpiresAt == nil {
		writeError(w, http.StatusUnauthorized, "token has no expiry claim")
		return
	}
	if time.Until(claims.ExpiresAt.Time) > 30*time.Second {
		writeError(w, http.StatusBadRequest, "token is not close enough to expiry to be refreshed")
		return
	}

	// Now, create a new token for the current use, with a renewed expiration time
	expirationTime := time.Now().Add(30 * 24 * time.Hour)
	claims.ExpiresAt = jwt.NewNumericDate(expirationTime)
	token := jwt.NewWithClaims(jwt.SigningMethodHS256, claims)
	tokenString, err := token.SignedString(i.key)
	if err != nil {
		writeError(w, http.StatusInternalServerError, "could not issue a token")
		return
	}

	// Set the new token as the users `session_token` cookie
	http.SetCookie(w, &http.Cookie{
		Name:    "session_token",
		Value:   tokenString,
		Expires: expirationTime,
	})

	res := TokenResponse{
		Token:   tokenString,
		Expires: expirationTime,
	}
	resJson, _ := json.Marshal(res)
	w.Write(resJson)
}
