package jwtserver

import (
	"time"

	"github.com/golang-jwt/jwt/v5"
)

type TokenResponse struct {
	Token   string
	Expires time.Time
}

// Create a struct that models the structure of a user, both in the request body, and in the DB
type Credentials struct {
	Password string `json:"password"`
	Email    string `json:"email"`
}

// Claims embeds jwt.RegisteredClaims, which supplies the getters the v5 Claims
// interface requires. The serialised form is unchanged from the v3
// StandardClaims this replaced: `exp` still marshals as a plain integer, because
// jwt.TimePrecision defaults to time.Second and NumericDate drops an empty
// fractional part. Tokens minted before the upgrade still validate after it.
type Claims struct {
	Email string `json:"email"`
	jwt.RegisteredClaims
}

type TokenRefresh struct {
	Token string `json:"token"`
}
