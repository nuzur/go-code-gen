package jwtserver

import (
	"context"
	"encoding/json"
	"net/http"
	"time"

	"github.com/golang-jwt/jwt/v5"
	"go.uber.org/zap"
	"golang.org/x/crypto/bcrypt"
	"{{.Module}}/{{.CoreConfig.CoreDir}}/module/{{.UserEntityIdentifier}}/types"
)

// invalidCredentials is returned for BOTH an unknown email and a wrong password.
//
// Answering "not found" for one and "unauthorized" for the other turns signin
// into an oracle for which email addresses have accounts. One status and one
// message for both closes that.
const invalidCredentials = "invalid email or password"

func (i *Implementation) SignIn(w http.ResponseWriter, r *http.Request) {
	origin := r.Header.Get("origin")
	method := r.Method
	w.Header().Set("Access-Control-Allow-Origin", origin)
	w.Header().Set("Access-Control-Allow-Methods", "POST, GET, OPTIONS, PUT, DELETE")
	w.Header().Set("Access-Control-Allow-Headers", "Accept, Content-Type, Content-Length, Accept-Encoding, X-CSRF-Token, Authorization")
	w.Header().Set("Accept", "application/json, multipart/mixed")
	w.Header().Set("Content-Type", "application/json")
	if method == "OPTIONS" {
		w.WriteHeader(http.StatusOK)
		return
	}
	// A GET used to fall through to the body decode and answer 400 "bad request",
	// which reads like the credentials were malformed rather than like the method
	// was wrong. Say which methods the endpoint takes instead.
	if method != http.MethodPost {
		w.Header().Set("Allow", "POST, OPTIONS")
		writeError(w, http.StatusMethodNotAllowed, "method not allowed, use POST")
		return
	}
	var creds Credentials
	// Get the JSON body and decode into credentials
	err := json.NewDecoder(r.Body).Decode(&creds)
	if err != nil {
		// If the structure of the body is wrong, return an HTTP error
		writeError(w, http.StatusBadRequest, `invalid request body, expected JSON {"email":"...","password":"..."}`)
		i.logger.Warn("error decoding credentials", zap.Error(err))
		return
	}
	ctx := context.Background()
	// Allow headroom for the first (cold) DB connection, which establishes the
	// TCP/TLS/handshake on first use and can exceed a sub-second budget against
	// a remote database.
	ctx, cancelFn := context.WithTimeout(ctx, time.Second*5)
	userRes, err := i.core.{{.UserEntityName}}().{{.UserFetchByEmailMethod}}(ctx, types.{{.UserFetchByEmailMethod}}Request{
		{{.UserEmailFieldName}}: creds.Email,
		Limit: 1,
	})
	defer cancelFn()

	if err != nil {
		writeError(w, http.StatusInternalServerError, "could not look up the user")
		i.logger.Error("error getting user", zap.Error(err))
		return
	}

    if len(userRes.Results) == 0 {
        // 401, NOT 404. A bodiless 404 from this handler is byte-identical to the
        // one the mux returns for a route it does not have, so "no user row with
        // that email" was read as "signin is not deployed". It is also the
        // enumeration oracle described above.
        writeError(w, http.StatusUnauthorized, invalidCredentials)
		i.logger.Warn("sign-in failed: no user with that email", zap.String("email", creds.Email))
		return
    }



	{{ if ne .UserPasswordField nil }}
	user := userRes.Results[0]
	{{$field := .UserPasswordField}}
	{{if $field.Required}}
	passwordStr := user.{{.UserPasswordFieldName}}
	{{else}}
	passwordStr := user.{{.UserPasswordFieldName}}.String
	{{end}}
	{{else}}
	passwordStr := ""
	{{end}}


	// The stored value must be a bcrypt hash; a plaintext password column fails
	// here with "hashedSecret too short to be a bcrypted password".
	err = bcrypt.CompareHashAndPassword([]byte(passwordStr), []byte(creds.Password))
	if err != nil {
		writeError(w, http.StatusUnauthorized, invalidCredentials)
		i.logger.Warn("sign-in failed: password mismatch", zap.String("email", creds.Email), zap.Error(err))
		return
	}

	// Declare the expiration time of the token
	expirationTime := time.Now().Add(30 * 24 * time.Hour)
	// Create the JWT claims, which includes the username and expiry time
	claims := &Claims{
		Email: creds.Email,
		RegisteredClaims: jwt.RegisteredClaims{
			ExpiresAt: jwt.NewNumericDate(expirationTime),
			IssuedAt:  jwt.NewNumericDate(time.Now()),
		},
	}

	// Declare the token with the algorithm used for signing, and the claims
	token := jwt.NewWithClaims(jwt.SigningMethodHS256, claims)
	// Create the JWT string
	tokenString, err := token.SignedString(i.key)
	if err != nil {
		// If there is an error in creating the JWT return an internal server error
		writeError(w, http.StatusInternalServerError, "could not issue a token")
		i.logger.Error("error generating token", zap.Error(err))
		return
	}

	// Finally, we set the client cookie for "token" as the JWT we just generated
	// we also set an expiry time which is the same as the token itself
	http.SetCookie(w, &http.Cookie{
		Name:    "token",
		Value:   tokenString,
		Expires: expirationTime,
	})

	res := TokenResponse{
		Token:   tokenString,
		Expires: expirationTime,
	}
	resJson, _ := json.Marshal(res)
	w.Write(resJson)
}
