package server

import (
	"fmt"
	"log"
	"net/http"

	"go.einride.tech/aip/filtering"
	"go.einride.tech/aip/ordering"

	"{{.Project.Module}}/{{.Project.CoreConfig.CoreDir}}/module/{{.FinalIdentifier}}/types"
	{{.FinalIdentifier}}module "{{.Project.Module}}/{{.Project.CoreConfig.CoreDir}}/module/{{.FinalIdentifier}}"
	main_entity "{{.Project.Module}}/{{.Project.EntitiesConfig.Dir}}/{{.FinalIdentifier}}"
)

func (h *handlers) List{{.Name}}(w http.ResponseWriter, r *http.Request) {
	defaultPageSize := int32({{.Project.RESTConfig.DefaultPageSize}})
	maxPageSize := int32({{.Project.RESTConfig.MaxPageSize}})

	lp, err := parseListParams(r, defaultPageSize, maxPageSize)
	if err != nil {
		writeProblem(w, http.StatusBadRequest, err)
		return
	}

	offset, err := parsePageTokenOffset(lp.pageToken)
	if err != nil {
		writeProblem(w, http.StatusBadRequest, fmt.Errorf("invalid page token: %w", err))
		return
	}

	declarations := {{.FinalIdentifier}}Declarations()
	filter, err := filtering.ParseFilter(lp, declarations)
	if err != nil {
		writeProblem(w, http.StatusBadRequest, fmt.Errorf("invalid filter expression: %w", err))
		return
	}

	orderBy, err := ordering.ParseOrderBy(lp)
	if err != nil {
		writeProblem(w, http.StatusBadRequest, fmt.Errorf("invalid order_by expression: %w", err))
		return
	}

	req := types.ListRequest{
		Offset:                offset,
		PageSize:              lp.GetPageSize(),
		Filter:                filter,
		FilteringDeclarations: declarations,
		EnumValues:            {{.FinalIdentifier}}EnumValues(),
		OrderBy:               orderBy,
		IncludeFields:         lp.includeFields,
		ExcludeFields:         lp.excludeFields,
	}

	var result types.ListResponse
	if lp.skipCache {
		result, err = h.core.{{.Name}}().List(r.Context(), req, {{.FinalIdentifier}}module.WithSkipCache())
	} else {
		result, err = h.core.{{.Name}}().List(r.Context(), req)
	}
	if err != nil {
		// A filter or order_by the clause builder cannot express is the caller's
		// error, not the server's: statusForError turns it into a 400.
		writeProblem(w, statusForError(err), err)
		return
	}

	resp := ListEnvelope[main_entity.{{.Name}}]{
		Items: result.{{.Name}},
	}
	if result.HasNextPage {
		resp.NextPageToken = encodePageToken(offset + int64(lp.GetPageSize()))
	}

	writeJSON(w, http.StatusOK, resp)
}

func {{.FinalIdentifier}}Declarations() *filtering.Declarations {
	declarations, err := filtering.NewDeclarations(
		filtering.DeclareStandardFunctions(),
		filtering.DeclareIdent("true", filtering.TypeBool),
		filtering.DeclareIdent("false", filtering.TypeBool),

		{{range $entityDeclaration := .Declarations}}
		// {{$entityDeclaration.Identifier}}
		{{range $field := $entityDeclaration.Fields}}
		{{if eq $field.IsEnum true }}
		// An enum is filtered by its VALUE over REST — either quoted
		// (status = "active", matched case-insensitively against every spelling
		// in {{$.FinalIdentifier}}EnumValues) or as the generated value name ident
		// (status = STATUS_ACTIVE, the same spelling gRPC accepts). Both are
		// strings to the type checker; the number they stand for is resolved
		// from the value table, not from this declaration.
		filtering.DeclareIdent("{{$field.Name}}", filtering.TypeString),
		{{range $value := $field.EnumValues}}filtering.DeclareIdent("{{$value.ProtoName}}", filtering.TypeString),
		{{end}}
		{{else}}
		filtering.DeclareIdent("{{$field.Name}}", {{$field.Filtering}}),
		{{end}}
		{{end}}
		{{end}}
	)
	if err != nil {
		log.Printf("error creating declarations for {{.FinalIdentifier}}: %v", err)
	}
	return declarations
}

// {{.FinalIdentifier}}EnumValues maps each enum filter field to every accepted
// spelling of its values and the number the column stores. REST generates no
// protobuf enum types (an app built with --api rest has no proto package at
// all), so this table — not the filter declarations — is what makes an enum
// filter resolvable here.
func {{.FinalIdentifier}}EnumValues() map[string]map[string]int64 {
	return map[string]map[string]int64{
		{{range $entityDeclaration := .Declarations}}{{range $field := $entityDeclaration.Fields}}{{if eq $field.IsEnum true }}
		"{{$field.Name}}": { {{range $value := $field.EnumValues}}{{range $name := $value.Names}}
			"{{$name}}": {{$value.Number}},{{end}}{{end}}
		},
		{{end}}{{end}}{{end}}
	}
}
