	"encoding/json"
	"errors"
	"fmt"
	"io"
	"net/http"
	{{ if .HasIntPrimaryKey }}"strconv"{{ end }}

	"github.com/go-chi/chi/v5"
	{{ if .HasUUIDPrimaryKey }}"github.com/gofrs/uuid"{{ end }}

	"{{.Project.Module}}/{{.Project.CoreConfig.CoreDir}}/module/{{.FinalIdentifier}}/types"
	{{.FinalIdentifier}}module "{{.Project.Module}}/{{.Project.CoreConfig.CoreDir}}/module/{{.FinalIdentifier}}"
	main_entity "{{.Project.Module}}/{{.Project.EntitiesConfig.Dir}}/{{.FinalIdentifier}}"
)

func (h *handlers) Update{{.Name}}(w http.ResponseWriter, r *http.Request) {
	{{range $pk := .PrimaryKeys}}
	{{if $pk.IsUUID}}
	{{$pk.Name}}Str := chi.URLParam(r, "{{if gt (len $.PrimaryKeys) 1}}{{$pk.Identifier}}{{else}}id{{end}}")
	{{$pk.Name}}Val, err := uuid.FromString({{$pk.Name}}Str)
	if err != nil {
		writeProblem(w, http.StatusBadRequest, fmt.Errorf("invalid path parameter {{$pk.Name}}: %w", err))
		return
	}
	{{else if eq $pk.GolangType "int64"}}
	{{$pk.Name}}Str := chi.URLParam(r, "{{if gt (len $.PrimaryKeys) 1}}{{$pk.Identifier}}{{else}}id{{end}}")
	{{$pk.Name}}Val, err := strconv.ParseInt({{$pk.Name}}Str, 10, 64)
	if err != nil {
		writeProblem(w, http.StatusBadRequest, fmt.Errorf("invalid path parameter {{$pk.Name}}: %w", err))
		return
	}
	{{else}}
	{{$pk.Name}}Val := chi.URLParam(r, "{{if gt (len $.PrimaryKeys) 1}}{{$pk.Identifier}}{{else}}id{{end}}")
	{{end}}
	{{end}}

	fetchRes, err := h.core.{{.Name}}().Fetch{{.Name}}By{{.PrimaryKeysName}}(r.Context(), types.Fetch{{.Name}}By{{.PrimaryKeysName}}Request{
		{{range $pk := .PrimaryKeys}}{{$pk.Name}}: {{$pk.Name}}Val,
		{{end}}
	}, {{.FinalIdentifier}}module.WithSkipCache())
	if err != nil {
		writeProblem(w, http.StatusInternalServerError, err)
		return
	}
	if len(fetchRes.Results) == 0 {
		writeProblem(w, http.StatusNotFound, errors.New("entity not found"))
		return
	}

	existingEntity := fetchRes.Results[0]

	body, err := io.ReadAll(r.Body)
	if err != nil {
		writeProblem(w, http.StatusBadRequest, err)
		return
	}

	if err := MergePatch{{.Name}}(&existingEntity, body); err != nil {
		writeProblem(w, http.StatusBadRequest, err)
		return
	}

	// Path parameters are authoritative for the primary key(s).
	{{range $pk := .PrimaryKeys}}existingEntity.{{$pk.Name}} = {{$pk.Name}}Val
	{{end}}

	_, err = h.core.{{.Name}}().Update(r.Context(), types.UpsertRequest{
		{{.Name}}: existingEntity,
	})
	if err != nil {
		writeProblem(w, http.StatusInternalServerError, err)
		return
	}

	fetchResUpdated, err := h.core.{{.Name}}().Fetch{{.Name}}By{{.PrimaryKeysName}}(r.Context(), types.Fetch{{.Name}}By{{.PrimaryKeysName}}Request{
		{{range $pk := .PrimaryKeys}}{{$pk.Name}}: {{$pk.Name}}Val,
		{{end}}
	}, {{.FinalIdentifier}}module.WithSkipCache())
	if err != nil {
		writeProblem(w, http.StatusInternalServerError, err)
		return
	}

	if len(fetchResUpdated.Results) == 0 {
		writeProblem(w, http.StatusInternalServerError, errors.New("entity not found after update"))
		return
	}

	writeJSON(w, http.StatusOK, fetchResUpdated.Results[0])
}

// MergePatch{{.Name}} applies JSON merge-patch semantics: only the keys present
// in the request body overwrite the existing entity. It round-trips through the
// entity's own JSON tags so every field type (enums, nested entities, arrays)
// is handled without per-field reconstruction.
func MergePatch{{.Name}}(existing *main_entity.{{.Name}}, body []byte) error {
	var patch map[string]json.RawMessage
	if err := json.Unmarshal(body, &patch); err != nil {
		return fmt.Errorf("invalid request body: %w", err)
	}

	base, err := json.Marshal(existing)
	if err != nil {
		return err
	}
	var merged map[string]json.RawMessage
	if err := json.Unmarshal(base, &merged); err != nil {
		return err
	}

	for k, v := range patch {
		merged[k] = v
	}

	out, err := json.Marshal(merged)
	if err != nil {
		return err
	}
	return json.Unmarshal(out, existing)
}
