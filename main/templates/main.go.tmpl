package main
import (
	{{ if not (and .RESTConfig.Enabled .CoreConfig.Enabled) }}
	"net/http"
	"go.uber.org/config"
	{{ end }}
	"go.uber.org/fx"
	"go.uber.org/zap"
	{{.Identifier}}config "{{.Module}}/config"
	"{{.Module}}/{{.CoreConfig.CoreDir}}"

	{{ if and .ProtoConfig.Enabled .ProtoConfig.Server }}
	pbserver "{{.Module}}/idl/server"		
	{{end}}

	{{ if and .RESTConfig.Enabled .CoreConfig.Enabled }}
	restserver "{{.Module}}/{{.RESTConfig.Dir}}/server"
	{{end}}

	{{ if .AuthConfig.Enabled }}
	{{.AuthImport}}
	{{ end }}

	{{ if .MonitoringConfig.Enabled }}
	"{{.Module}}/monitoring"
	{{ end }}
	
	{{if eq .CoreConfig.EventsConfig.Enabled true}}
	"{{.Module}}/{{.CoreConfig.CoreDir}}/{{.CoreConfig.EventsConfig.Dir}}"
	{{end}}

	{{if eq .KafkaEnabled true}}
	saramafx "github.com/mklfarha/sarama-fx"
	{{end}}

	{{/* Import the custom zone only when GenerateCustom actually emits something
	     for it: worker.go needs core, grpc.go needs a gRPC server, rest.go needs
	     REST+core (which implies core). Custom enabled with none of those emits no
	     files at all, and importing the empty/absent package breaks the build. */}}
	{{ if and .CustomConfig.Enabled (or .CoreConfig.Enabled (and .ProtoConfig.Enabled .ProtoConfig.Server)) }}
	"{{.Module}}/{{.CustomConfig.Dir}}"
	{{ end }}

	{{ if not .InfoConfig.Disabled }}
	"{{.Module}}/info"
	{{ end }}

	{{ if .StorageConfig.Enabled }}
	"{{.Module}}/storage"
	{{ end }}
)

func main() {
	fx.New(
		fx.Provide(
			zap.NewProduction,
			{{.Identifier}}config.New,
			core.New,	
			{{ if .MonitoringConfig.Enabled }}monitoring.New,{{end}}
			{{ if ne .AuthImport ""}}auth.New,{{end}}
			{{ if eq .CoreConfig.EventsConfig.Enabled true}}events.New,{{end}}
			{{ if .CustomConfig.Enabled }}
			{{ if and .ProtoConfig.Enabled .ProtoConfig.Server }}
			pbserver.NewServer,          // generated impl, wrapped by the app override
			{{.CustomConfig.Dir}}.NewOverride,
			{{ end }}
			{{ if and .RESTConfig.Enabled .CoreConfig.Enabled }}
			{{.CustomConfig.Dir}}.ProvideCustomRoutes,
			{{ end }}
			{{ end }}
		),
		{{ if not .InfoConfig.Disabled }}
		fx.Invoke(info.Register),
		{{ end }}
		{{ if .StorageConfig.Enabled }}
		fx.Invoke(storage.Register),
		{{ end }}
		{{ if and .CustomConfig.Enabled .CoreConfig.Enabled }}
		fx.Invoke({{.CustomConfig.Dir}}.RegisterWorkers),
		{{ end }}
		{{ if and .RESTConfig.Enabled .CoreConfig.Enabled }}
		fx.Invoke(restserver.New),
		{{ else }}
		fx.Invoke(httpServer),
		{{ end }}
		{{ if eq .KafkaEnabled true }}saramafx.Module,{{end}}		
		{{ if and .ProtoConfig.Enabled .ProtoConfig.Server }}fx.Invoke(pbserver.New),{{end}}		
	).Run()
}


{{ if not (and .RESTConfig.Enabled .CoreConfig.Enabled) }}
func httpServer(config config.Provider, logger *zap.Logger){
	// http port from config 
	httpPort := config.Get("ports.http").String()

	go http.ListenAndServe(":"+httpPort, nil)

	logger.Info(`Serving HTTP on PORT: %s`, zap.String("port", httpPort))
}
{{end}}


