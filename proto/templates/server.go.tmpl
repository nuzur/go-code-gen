// asInvalidArgument re-reports a core error the CALLER caused as
// codes.InvalidArgument. The core layer marks those with a BadRequest() method
// rather than a sentinel value, so this matches on the BEHAVIOUR and needs no
// import of the package that raised it.
//
// The concrete case this exists for: a filter or order_by expression the list
// clause builder cannot turn into SQL (list.InvalidRequestError). Anything else
// is passed through untouched.
func asInvalidArgument(err error) error {
	if err == nil {
		return nil
	}
	var badRequest interface{ BadRequest() bool }
	if errors.As(err, &badRequest) && badRequest.BadRequest() {
		return status.Error(codes.InvalidArgument, err.Error())
	}
	return err
}

// declareEnumIdent declares an enum filter ident the way aip-go does, and then
// additionally allows its value to be written as a QUOTED STRING.
//
// filtering.DeclareEnumIdent only declares `=` / `!=` over (enum, enum), so
// `status = "active"` — the form a REST-shaped client writes, and the form the
// generated REST surface accepts — failed the type check here with "no matching
// overload". The extra overloads make the two surfaces accept the same filter
// strings; the value itself is resolved by the clause builder against the
// entity's value table (see <entity>EnumValues), which understands both
// spellings.
func declareEnumIdent(name string, enumType protoreflect.EnumType) filtering.DeclarationOption {
	return func(d *filtering.Declarations) error {
		if err := filtering.DeclareEnumIdent(name, enumType)(d); err != nil {
			return err
		}
		celType := filtering.TypeEnum(enumType)
		for _, fn := range []string{filtering.FunctionEquals, filtering.FunctionNotEquals} {
			overload := filtering.NewFunctionOverload(
				fn+"_"+celType.GetMessageType()+"_string",
				filtering.TypeBool,
				celType,
				filtering.TypeString,
			)
			// Declaring the same overload twice (two fields of the same enum
			// type) is a no-op, not an error: aip compares the declarations.
			if err := filtering.DeclareFunction(fn, overload)(d); err != nil {
				return err
			}
		}
		return nil
	}
}

type server struct {
	pb.Unimplemented{{.Name}}Server
	core *core.Implementation
	{{ if .Project.MonitoringConfig.Enabled }}
	monitoring *monitoring.Implementation
	{{ end }}
}

{{ if .Project.CustomConfig.Enabled }}
// Override lets the custom application layer (the app package) supply its own
// implementation of the {{.Name}} service — typically the generated server
// wrapped with custom endpoints / custom logic. When one is provided via fx it
// is registered in place of the default generated implementation.
type Override interface {
	pb.{{.Name}}Server
}
{{ end }}

type Params struct {
	fx.In
	Logger *zap.Logger `optional:"true"`
	Lifecycle fx.Lifecycle
	Core   *core.Implementation
	Config config.Provider
	{{ if .Project.MonitoringConfig.Enabled }}	
	Monitoring *monitoring.Implementation
	{{ end }}
	{{ if ne .AuthImport ""}}
	Auth   auth.Interface
	{{ end }}
	{{ if .Project.CustomConfig.Enabled }}
	// Optional custom implementation provided by the app package. Registered in
	// place of the generated server when present.
	Override Override `optional:"true"`
	{{ end }}
}

{{ if .Project.CustomConfig.Enabled }}
// NewServer builds the default generated implementation. With the custom layer
// enabled it is provided to fx and wrapped by the app-level Override, so it must
// depend ONLY on its own inputs — never on Override — otherwise fx sees
// NewServer -> Override -> NewServer and rejects the graph as a cycle.
func NewServer(core *core.Implementation{{ if .Project.MonitoringConfig.Enabled }}, monitoring *monitoring.Implementation{{ end }}) pb.{{.Name}}Server {
	return &server{
		core: core,
		{{ if .Project.MonitoringConfig.Enabled }}monitoring: monitoring,{{ end }}
	}
}
{{ else }}
func NewServer(params Params) pb.{{.Name}}Server {
	return &server{
		core: params.Core,
		{{ if .Project.MonitoringConfig.Enabled }}
		monitoring: params.Monitoring,
		{{ end }}
	}
}
{{ end }}

func New(params Params) *grpc.Server {
	log := params.Logger
	if log == nil {
		log = zap.NewNop()
	}
	s := grpc.NewServer(
		{{ if ne .AuthImport ""}}
		{{ if .Project.MonitoringConfig.Enabled }}
		grpc.UnaryInterceptor(AuthUnaryServerInterceptor(params.Auth, params.Monitoring, []string{})),
		{{else}}
		grpc.UnaryInterceptor(AuthUnaryServerInterceptor(params.Auth, []string{})),
		{{end}}
		{{ end }}
	)
	params.Lifecycle.Append(fx.Hook{
		OnStart: func(ctx context.Context) error {
			// GRPC port from config
			grpcPort := params.Config.Get("ports.grpc").String()

			// proto server
			lis, err := net.Listen("tcp", fmt.Sprintf(":%s", grpcPort))
			if err != nil {
				log.Error("failed to listen: %v", zap.Error(err))
				return err
			}
						
			// register grpc servers
			grpc_health_v1.RegisterHealthServer(s, health.NewServer())
			{{- if .Project.CustomConfig.Enabled }}
			var impl pb.{{.Name}}Server
			if params.Override != nil {
				impl = params.Override
			} else {
				impl = NewServer(params.Core{{ if .Project.MonitoringConfig.Enabled }}, params.Monitoring{{ end }})
			}
			pb.Register{{.Name}}Server(s, impl)
			{{- else }}
			pb.Register{{.Name}}Server(s, NewServer(params))
			{{- end }}
			reflection.Register(s)

			log.Info("GRPC Server listening at %v", zap.Any("addr", lis.Addr()))

			go s.Serve(lis)

			return nil

		},
		OnStop: func(ctx context.Context) error {
			s.Stop()
			return nil
		},
	})
	
	
	return s
}