syntax = "proto3";

option go_package = "{{.Project.Identifier}}/{{.Project.ProtoConfig.Dir}}/gen";
option java_multiple_files = true;
option java_package = "{{.Project.Module}}";
option java_outer_classname = "{{.Name}}";

package {{.Project.Identifier}};

{{range $imp, $empty := .Imports}}
import "{{$imp}}";{{end}}

message {{.Name}} {  {{range $index, $field := .Fields}}
    {{$field.ProtoType}} {{$field.ProtoName}} = {{Inc $index}};{{end}}    
}
