func AuthUnaryServerInterceptor(auth auth.Interface, exceptions []string) grpc.UnaryServerInterceptor {
{{else}}
func AuthUnaryServerInterceptor(exceptions []string) grpc.UnaryServerInterceptor {
{{end}}
    return grpc.UnaryServerInterceptor(func (ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (resp any, err error){

		finalExceptions := []string{
			"/grpc.health.v1.Health/Check",
			"/grpc.health.v1.Health/Watch",
		}
		finalExceptions = append(exceptions, finalExceptions...)
		if slices.Contains(finalExceptions, info.FullMethod) {
			return handler(ctx, req)
		}	
		{{ if .Project.AuthConfig.Enabled }}	
		token, err := GetAuthorizationToken(ctx)       
        if err != nil {
			{{ if .Project.MonitoringConfig.Enabled }}
             m.Emit(monitoring.EmitRequest{
				ActionIdentifier: "invalid_auth_token",
				Message: "error parsing auth token",				
				Layer: monitoring.ProtocolServiceLayer,
				LayerSubtype: "protobuf",
				Type: monitoring.EmitTypeError,				
				Error: err,		
			})
			{{end}}
            return nil, status.Error(codes.Unauthenticated, err.Error())
        }

        err = auth.HandleToken(ctx, token)
        if err != nil {
			{{ if .Project.MonitoringConfig.Enabled }}
            m.Emit(monitoring.EmitRequest{
				ActionIdentifier: "invalid_auth",
				Message: "error handling auth",				
				Layer: monitoring.ProtocolServiceLayer,
				LayerSubtype: "protobuf",
				Type: monitoring.EmitTypeError,				
				Error: err,		
			})
			{{end}}
            return nil, status.Error(codes.Unauthenticated, fmt.Sprintf("invalid token %v", err))
        }       
		{{end}} 
        return handler(ctx, req)
    })
}

// bearerScheme is matched CASE-INSENSITIVELY: RFC 7235 defines the auth scheme
// as case-insensitive, grpc-go's own credential helpers emit "Bearer", and every
// string this project prints (deploy summary, info page, MCP prompt) says
// "Bearer" — while this interceptor used to accept only the lowercase spelling
// and rejected the documented form with "invalid token format".
const bearerScheme = "bearer "

func extractToken(header []string) (string, error) {
	if len(header) != 1 {
		return "", status.Error(codes.Unauthenticated, `invalid token format, expected "authorization: Bearer <token>"`)
	}
	token, ok := cutBearerScheme(header[0])
	if !ok {
		return "", status.Error(codes.Unauthenticated, `invalid token format, expected "authorization: Bearer <token>"`)
	}
	return token, nil
}

// cutBearerScheme strips the auth scheme from an authorization header value.
// It cuts the PREFIX rather than splitting on the literal: strings.Split takes
// index 1 of every occurrence, so a token that happens to contain "bearer "
// came back truncated instead of being returned whole (or rejected).
func cutBearerScheme(header string) (string, bool) {
	header = strings.TrimSpace(header)
	if len(header) < len(bearerScheme) || !strings.EqualFold(header[:len(bearerScheme)], bearerScheme) {
		return "", false
	}
	token := strings.TrimSpace(header[len(bearerScheme):])
	return token, token != ""
}

func GetAuthorizationToken(ctx context.Context) (string, error) {
	meta, ok := metadata.FromIncomingContext(ctx)        
	if !ok {
		return "", errors.New("missing metadata")
	}
	if len(meta["authorization"]) != 1 {
		return "", errors.New("authorization metadata not found")
	}

	return extractToken(meta["authorization"])	
}

